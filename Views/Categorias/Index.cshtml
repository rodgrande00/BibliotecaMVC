@model IEnumerable<Categoria>
@{
    ViewData["Title"] = "Categorías";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Gestión de Categorías</h1>
    <a asp-action="Create" class="btn btn-success">Nueva categoría</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info" role="alert">
        Todavía no hay categorías registradas. Use el botón <strong>Nueva categoría</strong> para agregar la primera.
    </div>
}
else
{
    <table class="table table-striped table-bordered table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th scope="col">ID</th>
                <th scope="col">Nombre</th>
                <th scope="col">Descripción</th>
                <th scope="col">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var categoria in Model)
            {
                <tr>
                    <td>@categoria.Id</td>
                    <td>@categoria.Nombre</td>
                    <td>@categoria.Descripcion</td>
                    <td>
                        <div class="d-flex gap-1">
                            <a asp-action="Details" asp-route-id="@categoria.Id" class="btn btn-sm btn-info">Ver</a>
                            <a asp-action="Edit" asp-route-id="@categoria.Id" class="btn btn-sm btn-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@categoria.Id" class="btn btn-sm btn-danger">Eliminar</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
