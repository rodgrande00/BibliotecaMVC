@{
    ViewData["Title"] = "Acceso denegado";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <section class="card shadow-sm tarjeta-acceso">
            <div class="card-body p-4">
                <h1 class="h3">Acceso denegado</h1>
                <div class="alert alert-warning" role="alert">
                    Su cuenta no tiene permiso para esta operación. Consultar libros está disponible
                    para Usuario, Bibliotecario y Admin. Agregar, editar y eliminar corresponde solo a Bibliotecario y Admin.
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-controller="Libros" asp-action="Index" class="btn btn-primary">Volver a libros</a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Ir al inicio</a>
                </div>
            </div>
        </section>
    </div>
</div>
