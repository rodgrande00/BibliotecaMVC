@functions {
    // Indica si el enlace del menú corresponde a la página que se está mostrando.
    private bool EsActual(string controlador, string accion)
    {
        return string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), controlador, StringComparison.OrdinalIgnoreCase)
            && string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), accion, StringComparison.OrdinalIgnoreCase);
    }
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Biblioteca Virtual: catálogo de libros, autores, categorías y servicios bibliotecarios en línea." />
    <title>@ViewData["Title"] - BibliotecaMVC</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BibliotecaMVC.styles.css" asp-append-version="true" />
</head>
<body>
    @* Sprite de iconos: se carga una vez y lo reutilizan todas las vistas *@
    <partial name="Componentes/_IconosSvg" />

    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">BibliotecaMVC</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark @(EsActual("Home", "Index") ? "active fw-semibold" : null)"
                               aria-current="@(EsActual("Home", "Index") ? "page" : null)"
                               asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark @(EsActual("Libros", "Index") ? "active fw-semibold" : null)"
                               aria-current="@(EsActual("Libros", "Index") ? "page" : null)"
                               asp-area="" asp-controller="Libros" asp-action="Index">Libros</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark @(EsActual("Autores", "Index") ? "active fw-semibold" : null)"
                               aria-current="@(EsActual("Autores", "Index") ? "page" : null)"
                               asp-area="" asp-controller="Autores" asp-action="Index">Autores</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark @(EsActual("Categorias", "Index") ? "active fw-semibold" : null)"
                               aria-current="@(EsActual("Categorias", "Index") ? "page" : null)"
                               asp-area="" asp-controller="Categorias" asp-action="Index">Categorías</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark @(EsActual("Home", "Usuarios") ? "active fw-semibold" : null)"
                               aria-current="@(EsActual("Home", "Usuarios") ? "page" : null)"
                               asp-area="" asp-controller="Home" asp-action="Usuarios">Usuarios</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark @(EsActual("Home", "Prestamos") ? "active fw-semibold" : null)"
                               aria-current="@(EsActual("Home", "Prestamos") ? "page" : null)"
                               asp-area="" asp-controller="Home" asp-action="Prestamos">Préstamos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark @(EsActual("Home", "AcercaDe") ? "active fw-semibold" : null)"
                               aria-current="@(EsActual("Home", "AcercaDe") ? "page" : null)"
                               asp-area="" asp-controller="Home" asp-action="AcercaDe">Acerca de</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav align-items-sm-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item d-flex align-items-center gap-2 me-sm-2">
                                <span class="navbar-text">@User.Identity.Name</span>
                                @if (User.IsInRole(RolesBiblioteca.Administrador))
                                {
                                    <span class="badge text-bg-primary">Administrador</span>
                                }
                                else if (User.IsInRole(RolesBiblioteca.Lector))
                                {
                                    <span class="badge text-bg-secondary">Lector</span>
                                }
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-secondary btn-sm">Cerrar sesión</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark @(EsActual("Account", "Login") ? "active fw-semibold" : null)"
                                   aria-current="@(EsActual("Account", "Login") ? "page" : null)"
                                   asp-controller="Account" asp-action="Login">Iniciar sesión</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark @(EsActual("Account", "Registro") ? "active fw-semibold" : null)"
                                   aria-current="@(EsActual("Account", "Registro") ? "page" : null)"
                                   asp-controller="Account" asp-action="Registro">Registrarse</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            <partial name="_Mensaje" />
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - BibliotecaMVC
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
