@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <section class="card shadow-sm tarjeta-acceso">
            <div class="card-body p-4">
                <h1 class="h3">No se pudo completar la operación</h1>
                <div class="alert alert-danger" role="alert">
                    Ocurrió un problema al procesar la solicitud. Intente de nuevo más tarde.
                    Si el problema continúa, contacte al personal de la biblioteca.
                </div>
                @if (Model.ShowRequestId)
                {
                    <p class="text-body-secondary mb-4">Código de referencia: <code>@Model.RequestId</code></p>
                }
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Ir al inicio</a>
            </div>
        </section>
    </div>
</div>
