@model IEnumerable<LibroViewModel>
@{
    ViewData["Title"] = "Libros";
}

<div class="d-flex justify-content-between align-items-center mb-2">
    <h1 class="mb-0">Gestión de Libros</h1>
    @if (User.IsInRole(RolesBiblioteca.Administrador))
    {
        <a asp-action="Create" class="btn btn-success">Nuevo libro</a>
    }
</div>
<p class="text-body-secondary mb-4">@Model.Count() libros registrados.</p>

@if (!Model.Any())
{
    <div class="alert alert-info" role="alert">
        Todavía no hay libros registrados.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
        @foreach (var libro in Model)
        {
            <div class="col">
                <article class="card h-100 shadow-sm">
                    <img src="@libro.ImagenUrl" class="card-img-top object-fit-cover" height="280"
                         alt="Portada de @libro.Titulo" />
                    <div class="card-body">
                        <h2 class="card-title h5">@libro.Titulo</h2>
                        <h3 class="card-subtitle h6 mb-3 text-body-secondary">@libro.NombreAutor</h3>
                        <p class="card-text mb-1"><small class="text-body-secondary">ISBN: @libro.Isbn</small></p>
                        <p class="card-text mb-3"><small class="text-body-secondary">@libro.Genero · @libro.AnioPublicacion</small></p>
                        @if (libro.Disponible)
                        {
                            <span class="badge bg-success">Disponible</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Prestado</span>
                        }
                    </div>
                    <div class="card-footer bg-transparent">
                        <div class="btn-group btn-group-sm" role="group" aria-label="Acciones de @libro.Titulo">
                            <a asp-action="Details" asp-route-id="@libro.Id" class="btn btn-outline-info">Ver</a>
                            @if (User.IsInRole(RolesBiblioteca.Administrador))
                            {
                                <a asp-action="Edit" asp-route-id="@libro.Id" class="btn btn-outline-primary">Editar</a>
                                <a asp-action="Delete" asp-route-id="@libro.Id" class="btn btn-outline-danger">Eliminar</a>
                            }
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
}
