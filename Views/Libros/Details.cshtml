@model LibroViewModel
@{
    ViewData["Title"] = "Detalle del libro";
}

<h1 class="mb-4">@Model.Titulo</h1>

<div class="card shadow-sm">
    <div class="row g-0">
        <div class="col-md-4">
            <img src="@Model.ImagenUrl" class="img-fluid rounded-start object-fit-cover w-100" height="420"
                 alt="Portada de @Model.Titulo" />
        </div>
        <div class="col-md-8">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">ID</dt>
                    <dd class="col-sm-8">@Model.Id</dd>

                    <dt class="col-sm-4">Título</dt>
                    <dd class="col-sm-8">@Model.Titulo</dd>

                    <dt class="col-sm-4">Autor</dt>
                    <dd class="col-sm-8">@Model.NombreAutor</dd>

                    <dt class="col-sm-4">ISBN</dt>
                    <dd class="col-sm-8">@Model.Isbn</dd>

                    <dt class="col-sm-4">Género</dt>
                    <dd class="col-sm-8">@Model.Genero</dd>

                    <dt class="col-sm-4">Año de publicación</dt>
                    <dd class="col-sm-8">@Model.AnioPublicacion</dd>

                    <dt class="col-sm-4">Estado</dt>
                    <dd class="col-sm-8">
                        @if (Model.Disponible)
                        {
                            <span class="badge bg-success">Disponible</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Prestado</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<div class="d-flex flex-wrap gap-2 mt-4">
    @if (User.IsInRole(RolesBiblioteca.Admin) || User.IsInRole(RolesBiblioteca.Bibliotecario))
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Eliminar</a>
    }
    <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
</div>
